{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "outDir": "out",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "rewriteRelativeImportExtensions": true,
    "types": ["node"]
  },
  "include": [
    "src/extension.ts",
    "src/protocol.ts",
    "src/setupHint.ts",
    "src/panel/**/*.ts",
    "src/host/**/*.ts",
    "src/parser/**/*.ts",
    "src/shims-js-yaml.d.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/graph/**",
    "src/webview/**"
  ]
}
