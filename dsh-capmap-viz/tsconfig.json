{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "lib",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "src/index.ts",
    "src/invariant.ts",
    "src/parser/**/*.ts",
    "src/shims-js-yaml.d.ts",
    "src/shims-dsh-host.d.ts"
  ],
  "exclude": ["src/**/*.test.ts", "src/client/**"]
}
