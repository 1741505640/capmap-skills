{
  "name": "@chenjh12/dsh-capmap-viz",
  "version": "0.2.3",
  "description": "CapMap docs visualization for DeepSeek Harness (graph + capability panel)",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1741505640/capmap-skills.git",
    "directory": "dsh-capmap-viz"
  },
  "homepage": "https://github.com/1741505640/capmap-skills/tree/main/dsh-capmap-viz",
  "bugs": {
    "url": "https://github.com/1741505640/capmap-skills/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./invariant": "./lib/invariant.js",
    "./src/*": "./src/*",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "files": [
    "lib",
    "src",
    "client",
    "assets",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc && npm run build:client",
    "build:client": "esbuild src/client/index.tsx --bundle --format=cjs --platform=browser --jsx=automatic --outfile=client/client.js --external:react --external:react/jsx-runtime --external:react-dom --external:react-dom/client --external:@deepseek-ai/cordis && node scripts/normalize-client-banner.mjs",
    "test": "node --experimental-strip-types --test src/parser/parse.test.ts src/parser/queries.test.ts src/client/graph/graph.test.ts src/client/panel/themeTree.test.ts src/setupHint.test.ts src/bootstrap/scaffold.test.ts src/bootstrap/docsRootName.test.ts src/bootstrap/installSkills.test.ts",
    "publish:npm": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/publish.ps1"
  },
  "license": "MIT",
  "dependencies": {
    "chokidar": "^4.0.3",
    "d3-force": "^3.0.0",
    "js-yaml": "^4.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-fs": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": ">=0.1.0-rc.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-layout": {
      "optional": true
    },
    "@deepseek-ai/dsh-invariants": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-fs": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": ">=0.1.0-rc.6",
    "@types/d3-force": "^3.0.10",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.4.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.5",
    "esbuild": "^0.25.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.8.0"
  }
}
